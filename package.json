{
    "name": "vac-js",
    "description": "A lightweight Steam Community script.",
    "version": "4.0.0",
    "author": "Matt Walters <bluemwhitew@hotmail.co.uk>",
    "bugs": {
        "url": "https://www.github.com/bluemwhitew/vac-js/issues"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24.20",
        "npm": ">=11.19"
    },
    "homepage": "https://www.github.com/bluemwhitew/vac-js",
    "keywords": [
        "aimbot",
        "cheater",
        "community",
        "reported",
        "steam",
        "steamcommunity",
        "steamfriends",
        "vac",
        "valve",
        "wallhack"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git@github.com:bluemwhitew/vac-js.git"
    },
    "scripts": {
        "build": "esbuild src/index.ts --bundle --outfile=dist/vac.js",
        "build:min": "esbuild src/index.ts --bundle --minify --outfile=dist/vac.min.js",
        "typecheck": "tsc --noEmit"
    }
}
